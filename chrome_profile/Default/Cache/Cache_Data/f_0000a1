    // Fallbacks
    --black: #000000;
    --white: #ffffff;

    --grey: #6f6f6f;
    --greyMid: #999999;
    --greyLight: #e4ebf2;

    --availableHover: #c0e992;
    --availableActive: #7ed321;
}
`,`//Unsetting styles to avoid clashes with styles outside the component
%unset {
    padding: unset;
    margin-top: unset;
    margin-bottom: unset;
    margin-left: unset;
    margin-right: unset;
    border: unset;
    background: unset;
    border-spacing: 0;
    font-style: unset;
    list-style: unset;
}
`,`.AR__button {
    appearance: none;
    background: none;
    border: none;
    border-radius: 0;
    font-family: inherit;
    position: relative;
    display: block;
    cursor: pointer;
    font-size: 1em;
    border: 0.1em solid var(--greyMid);
    background-color: var(--white);

    &:focus {
        border-color: var(--availableActive);
        box-shadow: inset var(--availableActive) 0 0 0 0.1em;
        box-shadow: inset var(--availableActive) 0 0 0 0.1em;
        outline: none;
    }
    &:hover {
        border-color: var(--availableActive);
        box-shadow: inset var(--availableActive) 0 0 0 0.1em;
        background-color: var(--availableHover);
        color: var(--black);
        outline: none;
    }

    &:active {
        background-color: var(--availableActive);
        color: var(--black);
        outline: none;
    }
}

.AR__disabled-button {
    pointer-events: none;
    border: unset;
    background-color: unset;

    &:focus {
        border-color: unset;
        box-shadow: unset;
        outline: none;
        background-color: unset;
    }
    &:hover {
        border-color: unset;
        box-shadow: unset;
        outline: none;
    }

    &:active {
        border-color: unset;
        box-shadow: unset;
        outline: none;
        background-color: unset;
    }
}
`,`.AR__timezone-selector {
    position: relative;
    flex-grow: 1;
    max-width: 16rem;
}

.AR__timezone-selector--button {
    @extend .AR__button;
    display: flex;
    justify-content: space-between;
    border: 0.1em solid var(--greyMid);
    background: var(--white);
    padding: 0.3em 1em;
    text-align: left;
    width: 100%;
    border-radius: 0.4em;
    z-index: 4;
}

.AR__timezone-selector--icon {
    width: 1em;
    height: 1em;
    margin-top: 0.2em;
    fill: var(--grey);
    float: right;
}

.AR__timezone-selector--icon-open {
    transform: scaleY(-1);
}

.AR__timezone-selector--listbox-wrapper {
    @extend %unset;
    position: absolute;
    width: 100%;
    border: 0.1em solid var(--greyMid);
    background-color: var(--white);
    border-top: 0;
    padding-top: 1.15em;
    top: 1em;
    z-index: 3;
    border-radius: 0 0 0.4em 0.4em;
}

.AR__timezone-selector--listbox {
    @extend %unset;
    width: 100%;
    max-height: 15em;
    overflow-y: auto;
}

.AR__timezone-selector--option {
    @extend %unset;
    display: block;
    cursor: pointer;
    padding: 0.5em 1em;
    position: relative;
    line-height: 1.8em;

    &:hover {
        background-color: var(--availableHover);
        color: var(--black);
    }
}

.AR__timezone-selector--focused {
    border-color: var(--availableActive);
    box-shadow: inset var(--availableActive) 0 0 0 0.1em;
    outline: none;
}

.AR__timezone-selector--selected {
    background-color: var(--availableHover);
    color: var(--black);
}
